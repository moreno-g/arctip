{
  "rewrites": [
    { "source": "/@:handle", "destination": "/tip.html" },
    { "source": "/app", "destination": "/app.html" }
  ],
  "headers": [
    {
      "comment": "App code changes with every deploy and the filenames are stable, so a returning visitor would otherwise keep running an old build. Revalidate these.",
      "source": "/js/(.*)",
      "headers": [{ "key": "Cache-Control", "value": "public, max-age=0, must-revalidate" }]
    },
    {
      "source": "/styles.css",
      "headers": [{ "key": "Cache-Control", "value": "public, max-age=0, must-revalidate" }]
    },
    {
      "comment": "Vendored libraries are pinned by version and never edited in place.",
      "source": "/vendor/(.*)",
      "headers": [{ "key": "Cache-Control", "value": "public, max-age=31536000, immutable" }]
    },
    {
      "source": "/fonts/(.*)",
      "headers": [{ "key": "Cache-Control", "value": "public, max-age=31536000, immutable" }]
    }
  ]
}
