# Hot key used only to broadcast the deployment. Never give it ownership.
DEPLOYER_PRIVATE_KEY=
ARC_TESTNET_RPC_URL=https://rpc.testnet.arc.network

# Wallet that receives the fee on every tip.
TREASURY_ADDRESS=

# Wallet allowed to change the fee, pause tipping and redirect the treasury.
